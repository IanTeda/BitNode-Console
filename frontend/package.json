{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite",
    "build:protoc": "protoc --experimental_allow_proto3_optional --proto_path=protos --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=src/generated protos/*.proto",
