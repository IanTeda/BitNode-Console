{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "proto:gen": "protoc --ts_out src/lib/generated_protos --ts_opt long_type_string --proto_path protos protos/bitnode_console/authentication/authentication.proto protos/bitnode_console/common/pagination.proto protos/bitnode_console/journals/journals.proto protos/bitnode_console/utilities/utilities.proto && find src/lib/generated_protos -name '*.ts' -exec sed -i '1i\\// @ts-nocheck' {} +"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tslog": "^4.10.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@protobuf-ts/plugin": "^2.11.1",
