# syntax=docker/dockerfile:1
# Pins the Dockerfile syntax to BuildKit 1.x, enabling --mount=type=cache and
# other BuildKit features on Docker 23+.
#
# Dockerfile for the BitNode Console static frontend.
#
# Two-stage build:
#   1. node:22-bookworm-slim  — compiles the Vite/React app into static assets.
#   2. nginx-unprivileged     — serves those assets; runs as non-root on port 8080.
#
# Runtime configuration is supplied via environment variables at `docker run`
# time. entrypoint.frontend.sh sed-replaces placeholder strings baked into the
# JS bundle and nginx config before nginx starts, so one image works across
# environments without a rebuild.
#
# Environment variables (with defaults):
#   BITNODE_PORT           — port nginx listens on          (default: 8080)
#   BITNODE_RPC_BASE_URL   — gRPC-Web backend address       (default: http://127.0.0.1:50051)
#   BITNODE_RPC_DEADLINE_MS — gRPC call timeout in ms       (default: 30000)
#
# Example:
#   docker build -f docker/Dockerfile.frontend -t bitnode-frontend .
#   docker run -e BITNODE_RPC_BASE_URL=https://rpc.example.com -p 8080:8080 bitnode-frontend

# --- Stage 1: Build frontend ---
# Bakes placeholder strings into the JS bundle so entrypoint.frontend.sh can
# sed-replace them with real values at container start, making a single image
# usable across environments.
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy manifests first so the pnpm install layer is cached independently of
# source changes — a source edit won't re-download packages.
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# --mount=type=cache persists the pnpm content-addressable store across builds,
# avoiding re-downloading packages that haven't changed.
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    corepack enable && pnpm install --frozen-lockfile

COPY frontend/ ./

# NODE_ENV=production enables minification and dead-code elimination in the
# Vite build. Set after pnpm install so devDependencies are still installed.
# Placeholders are sed-replaced at runtime by entrypoint.frontend.sh.
ENV NODE_ENV=production \
    BITNODE_PORT=8080 \
    BITNODE_RPC_BASE_URL=__BITNODE_RPC_BASE_URL__ \
    BITNODE_RPC_DEADLINE_MS=__BITNODE_RPC_DEADLINE_MS__
RUN pnpm build

# --- Stage 2: Minimal nginx runtime ---
# nginx-unprivileged runs as the non-root `nginx` user (uid 101) on port 8080,
# satisfying the principle of least privilege without extra runtime capabilities.
FROM nginxinc/nginx-unprivileged:1.27-alpine

# Set ownership to the nginx user during copy rather than running a chown RUN
# layer, which avoids duplicating file data in the image.
COPY --chown=nginx:nginx --from=builder /app/dist /usr/share/nginx/html
COPY --chown=nginx:nginx docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=nginx:nginx docker/entrypoint.frontend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Fail fast if nginx stops serving — lets orchestrators restart the container.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/ || exit 1

# EXPOSE is documentation only; the actual port is set via BITNODE_PORT (default 8080).
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]
